{
  "SpendAgentExecutionRole": [
    {
      "Sid": "S3SpendData",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:ListBucket"],
      "Resource": [
        "arn:aws:s3:::spend-data-q",
        "arn:aws:s3:::spend-data-q/spend-data/*"
      ]
    },
    {
      "Sid": "BedrockModel",
      "Effect": "Allow",
      "Action": "bedrock:InvokeModel",
      "Resource": "arn:aws:bedrock:ap-south-1::foundation-model/claude-sonnet-4-5-20251001"
    },
    {
      "Sid": "BedrockGuardrail",
      "Effect": "Allow",
      "Action": "bedrock:ApplyGuardrail",
      "Resource": "arn:aws:bedrock:ap-south-1:387957186026:guardrail/n0b79yy16s8i"
    },
    {
      "Sid": "AgentCoreMemory",
      "Effect": "Allow",
      "Action": [
        "bedrock-agentcore:PutMemoryEvent",
        "bedrock-agentcore:GetMemoryRecord",
        "bedrock-agentcore:ListMemoryRecords"
      ],
      "Resource": "*"
    }
  ],
  "SpendAgentLambdaRole": [
    {
      "Sid": "InvokeAgentCore",
      "Effect": "Allow",
      "Action": "bedrock-agentcore:InvokeAgentRuntime",
      "Resource": [
        "arn:aws:bedrock-agentcore:ap-south-1:387957186026:runtime/spendagentv1_MyAgent-TeCbnqAkL9",
        "arn:aws:bedrock-agentcore:ap-south-1:387957186026:runtime/spendagentv1_MyAgent-TeCbnqAkL9/runtime-endpoint/DEFAULT"
      ]
    },
    {
      "Sid": "BasicLambdaExecution",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:ap-south-1:387957186026:log-group:/aws/lambda/SpendAgentAdapter:*"
    }
  ]
}
